# Every public knob accepts an environment override. No package installation here.
export METHOD="${METHOD:-dflash_reflex}"
export FAIRNESS_PROFILE="${FAIRNESS_PROFILE:-native_dflash}"
export METRICS_MODE="${METRICS_MODE:-production}"
export GRPO_OBJECTIVE="${GRPO_OBJECTIVE:-specnaacl_sequence}"
export BETA="${BETA:-0.04}"
export EPSILON="${EPSILON:-0.1}"
export TARGET_LORA_R="${TARGET_LORA_R:-64}"
export TARGET_LORA_ALPHA="${TARGET_LORA_ALPHA:-32}"
export TARGET_LORA_DROPOUT="${TARGET_LORA_DROPOUT:-0.0}"
export GRPO_ITERATION_NUM="${GRPO_ITERATION_NUM:-1}"
export OPD_PIPELINE="${OPD_PIPELINE:-auto}"
export DATASET="${DATASET:-simplelr}"
export DATA_ROOT="${DATA_ROOT:-/workspace/storage-shared/nlp/minhpn19/data}"
export DATASET_PATH="${DATASET_PATH:-}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export NPROC_PER_NODE="${NPROC_PER_NODE:-1}"
export TARGET_LR="${TARGET_LR:-1e-6}"
export DRAFT_LR="${DRAFT_LR:-1e-4}"
export BATCH_SIZE="${BATCH_SIZE:-8}"
export ACCUMULATION_STEPS="${ACCUMULATION_STEPS:-4}"
export DRAFT_ACCUMULATION_STEPS="${DRAFT_ACCUMULATION_STEPS:-1}"
export TRAIN_MICRO_BATCH_SIZE="${TRAIN_MICRO_BATCH_SIZE:-1}"
export RESPONSES_PER_PROMPT="${RESPONSES_PER_PROMPT:-8}"
export GEN_MAX_LENGTH="${GEN_MAX_LENGTH:-2048}"
export MAX_PROMPT_LENGTH="${MAX_PROMPT_LENGTH:-2048}"
export TEMPERATURE="${TEMPERATURE:-1.0}"
export TOP_P="${TOP_P:-0.95}"
export DFLASH_BLOCK_SIZE="${DFLASH_BLOCK_SIZE:-16}"
export DFLASH_DRAFT_LR="${DFLASH_DRAFT_LR:-$DRAFT_LR}"
export DFLASH_LOSS_WEIGHT="${DFLASH_LOSS_WEIGHT:-0.1}"
export DFLASH_MASK_TOKEN_ID="${DFLASH_MASK_TOKEN_ID:-151669}"
export DFLASH_LAYERS="${DFLASH_LAYERS:-3}"
export DFLASH_ANCHORS_PER_SEQ="${DFLASH_ANCHORS_PER_SEQ:-16}"
export DFLASH_LOSS_CHUNK_SIZE="${DFLASH_LOSS_CHUNK_SIZE:-32}"
export OPD_RANK="${OPD_RANK:-8}"
export OPD_TOPK="${OPD_TOPK:-16}"
export OPD_FAST_LR="${OPD_FAST_LR:-0.01}"
export OPD_TRAIN_PROJECTOR="${OPD_TRAIN_PROJECTOR:-1}"
export OPD_PROJECTOR_LR="${OPD_PROJECTOR_LR:-1e-4}"
export OPD_PROJECTOR_WEIGHT_DECAY="${OPD_PROJECTOR_WEIGHT_DECAY:-0.0}"
export OPD_ACCEPTED_WEIGHT="${OPD_ACCEPTED_WEIGHT:-1.0}"
export OPD_REJECTED_WEIGHT="${OPD_REJECTED_WEIGHT:-1.0}"
export OPD_UPDATE_INTERVAL="${OPD_UPDATE_INTERVAL:-1}"
export OPD_UPDATE_STREAM="${OPD_UPDATE_STREAM:-1}"
export OPD_PROPOSAL_MODE="${OPD_PROPOSAL_MODE:-auto}"
export OPD_DENSE_IMPLEMENTATION="${OPD_DENSE_IMPLEMENTATION:-auto}"
export OPD_PROFILE="${OPD_PROFILE:-0}"
export OPD_DISPATCH_CACHE="${OPD_DISPATCH_CACHE:-}"
export OPD_DIAGNOSTICS="${OPD_DIAGNOSTICS:-0}"
export LOG_INTERVAL="${LOG_INTERVAL:-1}"
export ROLLOUT_LOG_FLUSH_INTERVAL="${ROLLOUT_LOG_FLUSH_INTERVAL:-1}"
export TRAIN_SUBSET_SEED="${TRAIN_SUBSET_SEED:-42}"
export MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES:-0}"
export MAX_GRPO_STEPS="${MAX_GRPO_STEPS:-1000000}"
export TRAIN_EPOCHS="${TRAIN_EPOCHS:-1}"
export SAVE_INTERVAL="${SAVE_INTERVAL:-50}"
export RESUME="${RESUME:-}"
export VLLM_MEMORY_UTILIZATION="${VLLM_MEMORY_UTILIZATION:-0.65}"
export REWARD_WORKERS="${REWARD_WORKERS:-8}"
export PRETRAIN_DATASET="${PRETRAIN_DATASET:-sharegpt}"
export PRETRAIN_DATASET_PATH="${PRETRAIN_DATASET_PATH:-$DATA_ROOT/sharegpt/ShareGPT_V4.3_unfiltered_cleaned_split.json}"
export PRETRAIN_EPOCHS="${PRETRAIN_EPOCHS:-5}"
export PRETRAIN_LR="${PRETRAIN_LR:-5e-5}"
export PRETRAIN_BATCH_SIZE="${PRETRAIN_BATCH_SIZE:-8}"
export PRETRAIN_ACCUMULATION_STEPS="${PRETRAIN_ACCUMULATION_STEPS:-4}"
export PRETRAIN_MAX_LENGTH="${PRETRAIN_MAX_LENGTH:-2048}"
export PRETRAIN_MAX_SAMPLES="${PRETRAIN_MAX_SAMPLES:-0}"
export PRETRAIN_MAX_STEPS="${PRETRAIN_MAX_STEPS:-0}"
export PRETRAIN_SAVE_INTERVAL="${PRETRAIN_SAVE_INTERVAL:-500}"
export PRETRAIN_DATALOADER_WORKERS="${PRETRAIN_DATALOADER_WORKERS:-4}"
export PRETRAIN_WARM_START="${PRETRAIN_WARM_START:-}"
